# 8SpeedyService Production Backend Environment Configuration
NODE_ENV=production
PORT=8080

# PostgreSQL 16 Connection String (Cloud SQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/speedy
DB_POOL_MAX=20
DB_SSL=true

# Firebase Project ID (for Phone Auth verification, FCM Push & App Check)
FIREBASE_PROJECT_ID=speedyservice-prod
# Optional on Cloud Run (uses default service account); required outside GCP:
# FIREBASE_SERVICE_ACCOUNT_B64=
APP_CHECK_ENFORCE=true

# Private GCS bucket for partner KYC documents
STORAGE_BUCKET=speedyservice-prod-kyc

# Platform commission in basis points (1500 = 15.00%)
COMMISSION_BPS=1500
# Use 'postgres' when running >1 Cloud Run instances so Socket.IO broadcasts across instances
SOCKET_ADAPTER=postgres
DISPATCH_WORKER=true
OFFER_TTL_SECONDS=20
DISPATCH_RADII_M=3000,6000,10000
LOG_LEVEL=info
