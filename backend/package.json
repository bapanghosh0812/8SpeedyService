{
  "name": "8speedyservice-backend",
  "version": "3.0.0",
  "private": true,
  "description": "8SpeedyService API: on-demand roadside mechanic dispatch",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:all": "tsx scripts/serve-all-local.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "admin": "tsx --env-file=.env src/admin-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@socket.io/postgres-adapter": "^0.4.0",
    "fastify": "^5.2.1",
    "firebase-admin": "^14.5.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.2.0-beta.15",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
